<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.sky.mapper.dishfloverMapper">


    <insert id="save">
        insert into dish_flavor (dish_id,name,value)
        values 
            <foreach collection="flavor" item="df" separator=",">
            (#{df.dishId},#{df.name},#{df.value})

            </foreach>
            </insert>
    <delete id="delete">
        delete from dish_flavor where dish_id in
        <foreach collection="list" item="s" open="(" separator="," close=")">
            #{s}
        </foreach>
    </delete>
    <select id="getById" resultType="com.sky.entity.DishFlavor">
        select *
        from dish_flavor where dish_id=#{dishId}
    </select>

</mapper>